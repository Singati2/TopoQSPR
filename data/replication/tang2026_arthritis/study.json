  "indices": [
    {
      "symbol_verbatim": "EM1",
      "name_verbatim": "reformulated first Zagreb index EM1(G)",
      "formula_verbatim": "EM1(G) = ∑mn∈E(G)(d(m) + d(n) – 2)2",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "EM2",
      "name_verbatim": "reformulated second Zagreb index EM2(G)",
      "formula_verbatim": "$EM_{2}(G)=∑_{mn∈E(G)}∑_{np∈E(G),p≠m}(d(m)+d(n)−2)(d(n)+d(p)−2)$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "M1",
      "name_verbatim": "first Zagreb index M 1(G)",
      "formula_verbatim": "M1(G) = ∑mn∈E(G)(dm + dn)",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "M2",
      "name_verbatim": "second Zagreb index M 2(G)",
      "formula_verbatim": "M2(G) = ∑mn∈E(G)(dm · dn)",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "AZI",
      "name_verbatim": "augmented Zagreb index AZI(G)",
      "formula_verbatim": "$AZI(G)=∑_{mn∈E(G)}((d(m)d(n))/(d(m)+d(n)−2))^{3}$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "HM",
      "name_verbatim": "hyper Zagreb index HM(G)",
      "formula_verbatim": "HM(G) = ∑mn∈E(G)(d(m) + d(n))2",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "F",
      "name_verbatim": "forgotten index F(G)",
      "formula_verbatim": "$F(G)=∑_{mn∈E(G)}(d_{m}^{2}+d_{n}^{2})$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "SDD",
      "name_verbatim": "symmetric division deg index SDD(G)",
      "formula_verbatim": "$SDD(G)=∑_{mn∈E(G)}((d(m))/(d(n))+(d(n))/(d(m)))$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ISZ",
      "name_verbatim": "inverse sum indeg index ISZ(G)",
      "formula_verbatim": "$ISZ(G)=∑_{mn∈E(G)}(d(m)+d(n))/(d(m)d(n))$",
      "family": "degree",
      "source": "Table 1"
    }
  ],
