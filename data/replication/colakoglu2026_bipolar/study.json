  "indices": [
    {
      "symbol_verbatim": "M1",
      "name_verbatim": "first Zagreb index",
      "formula_verbatim": "M 1(Γ) = ∑τq∈E(Γ) (d τ + d q)",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "M2",
      "name_verbatim": "second Zagreb index",
      "formula_verbatim": "M 2(Γ) = ∑τq∈E(Γ) d τ d q",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "F",
      "name_verbatim": "forgotten index",
      "formula_verbatim": "$F(Γ)=∑_{τq∈E(Γ)}(d_{τ}^{2}+d_{q}^{2})$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "SDD",
      "name_verbatim": "symmetric division degree index",
      "formula_verbatim": "$SDD(Γ)=∑_{τq∈E(Γ)}(d_{τ}^{2}+d_{q}^{2})/(d_{τ}d_{q})$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ISI",
      "name_verbatim": "inverse sum indeg index",
      "formula_verbatim": "$ISI(Γ)=∑_{τq∈E(Γ)}(d_{τ}d_{q})/(d_{τ}+d_{q})$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "H",
      "name_verbatim": "harmonic index",
      "formula_verbatim": "$H(Γ)=∑_{τq∈E(Γ)}(2)/(d_{τ}+d_{q})$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "SC",
      "name_verbatim": "sum connectivity index",
      "formula_verbatim": "$SC(Γ)=∑_{τq∈E(Γ)}(1)/(sqrt(d_{τ}+d_{q}))$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "R",
      "name_verbatim": "Randić index",
      "formula_verbatim": "$R(Γ)=∑_{τq∈E(Γ)}(1)/(sqrt(d_{τ}d_{q}))$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "σ",
      "name_verbatim": "sigma index",
      "formula_verbatim": "$σ(Γ)=∑_{τq∈E(Γ)}(d_{τ}−d_{q})^{2}$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "SO",
      "name_verbatim": "Sombor index",
      "formula_verbatim": "$SO(Γ)=∑_{τq∈E(Γ)}sqrt(d_{τ}^{2}+d_{q}^{2})$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ABC",
      "name_verbatim": "atom-bond connectivity index",
      "formula_verbatim": "$ABC(Γ)=∑_{τq∈E(Γ)}sqrt((d_{τ}+d_{q}−2)/(d_{τ}d_{q}))$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ABS",
      "name_verbatim": "atom-bond sum-connectivity index",
      "formula_verbatim": "$ABS(Γ)=∑_{τq∈E(Γ)}sqrt((d_{τ}+d_{q}−2)/(d_{τ}+d_{q}))$",
      "family": "degree",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "AZ",
      "name_verbatim": "augmented Zagreb index",
      "formula_verbatim": "$AZ(Γ)=∑_{τq∈E(Γ)}((d_{τ}d_{q})/(d_{τ}+d_{q}−2))^{3}$",
      "family": "degree",
      "source": "Table 1"
