  "indices": [
    {
      "symbol_verbatim": "ECI",
      "name_verbatim": "Eccentric connectivity index",
      "formula_verbatim": "$ECI=∑_{v∈V(G)}d(v)e(v)$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "AECI",
      "name_verbatim": "Augmented eccentric connectivity index",
      "formula_verbatim": "$AECI=∑_{u∈V(G)}(M(u))/(e(u))$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "TEI",
      "name_verbatim": "Total eccentricity index",
      "formula_verbatim": "$TEI=∑_{v∈V(G)}e(v)$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "IEI",
      "name_verbatim": "Inverse eccentricity index",
      "formula_verbatim": "$IEI=∑_{v∈V(G)}(1)/(e(v))$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "AEI",
      "name_verbatim": "Average eccentricity index",
      "formula_verbatim": "$AEI=(1)/(n)∑_{v∈V(G)}e(v)$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "EDS",
      "name_verbatim": "Eccentric distance sum index",
      "formula_verbatim": "$EDS=∑_{v∈V(G)}e(v)D(v)$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "CEI",
      "name_verbatim": "Connective eccentricity index",
      "formula_verbatim": "$CEI=∑_{v∈V(G)}(d(v))/(e(v))$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "EHI",
      "name_verbatim": "Eccentric-based harmonic index",
      "formula_verbatim": "$EHI=∑_{uv∈E(G)}(2)/(e(u)+e(v))$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "EM_{1}",
      "name_verbatim": "First Zagreb eccentricity index",
      "formula_verbatim": "$EM_{1}=∑_{v∈V(G)}(e(v))^{2}$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "EM_{2}",
      "name_verbatim": "Second Zagreb eccentricity index",
      "formula_verbatim": "$EM_{2}=∑_{uv∈E(G)}e(u)e(v)$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "EGA",
      "name_verbatim": "Geometric Arithmetic eccentricity index",
      "formula_verbatim": "$EGA=∑_{uv∈E(G)}(2sqrt(e(u)e(v)))/(e(u)+e(v))$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "EABC",
      "name_verbatim": "ABC eccentricity index",
      "formula_verbatim": "$EABC=∑_{uv∈E(G)}sqrt((e(u)+e(v)−2)/(e(u)e(v)))$",
      "family": "eccentricity",
      "source": "Table 3"
    },
    {
      "symbol_verbatim": "MECI",
      "name_verbatim": "Modified eccentric connectivity index",
      "formula_verbatim": "$MECI=∑_{v∈V(G)}δ_{v}e(v)$",
      "family": "eccentricity",
      "source": "Table 3"
    }
  ],
