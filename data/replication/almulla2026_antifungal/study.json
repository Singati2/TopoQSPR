  "indices": [
    {
      "symbol_verbatim": "NM_1",
      "name_verbatim": "First neighbourhood Zagreb26",
      "formula_verbatim": "$NM_1 = \\sum _{v \\in V(G)} \\delta (v)^2$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "NM_2",
      "name_verbatim": "Second Neighbourhood Zagreb26",
      "formula_verbatim": "$NM_2 = \\sum _{uv \\in E(G)} \\delta (u)\\delta (v)$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "NABC",
      "name_verbatim": "Neighbourhood atom bond connectivity27",
      "formula_verbatim": "$NABC = \\sum _{uv \\in E(G)} \\sqrt{\\frac{\\delta (u) + \\delta (v) - 2}{\\delta (u)\\delta (v)}}$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "NF_1",
      "name_verbatim": "Neighbourhood forgotten",
      "formula_verbatim": "$NF_1 = \\sum _{v \\in V(G)} \\delta (v)^3$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ND_1",
      "name_verbatim": "First neighbourhood degree product27",
      "formula_verbatim": "$ND_1=\\sum _{uv \\in E(G)} \\sqrt{(\\delta (u)\\delta (v)}$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ND_2",
      "name_verbatim": "Second neighbourhood degree product27",
      "formula_verbatim": "$ND_2 = \\sum _{uv \\in E(G)} \\frac{1}{\\sqrt{\\delta (u)+\\delta (v)}}$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ND_3",
      "name_verbatim": "Third neighbourhood degree product27",
      "formula_verbatim": "$ND_3= \\sum _{uv \\in E(G)} \\delta (u)\\delta (v)[\\delta (u) + \\delta (v)]$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ND_4",
      "name_verbatim": "Fourth neighbourhood degree product27",
      "formula_verbatim": "$ND_4 = \\sum _{uv \\in E(G)} \\frac{1}{\\sqrt{\\delta (u)\\delta (v)}}$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    },
    {
      "symbol_verbatim": "ND_5",
      "name_verbatim": "Fifth neighbourhood degree product",
      "formula_verbatim": "$ND_5 = \\sum _{uv \\in E(G)} [\\frac{\\delta (u)}{\\delta (v)}+\\frac{\\delta (v)}{\\delta (u)}]$",
      "family": "neighborhood_degree_sum",
      "source": "Table 1"
    }
  ],
