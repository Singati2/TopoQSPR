  "indices": [
    {
      "symbol_verbatim": "M1Φm(G)",
      "name_verbatim": "Chromatic modified first Zagreb index",
      "formula_verbatim": "$M1Φm(G)=∑_{v∈V(G)}[(1)/(c(v)^{2})]=∑_{j=1}^{l}[(1)/(θ(c_{j})j^{2})]$",
      "family": "chromatic (proper vertex colouring)",
      "source": "Equations (1)-(4)"
    },
    {
      "symbol_verbatim": "M2Φm(G)",
      "name_verbatim": "Chromatic modified second Zagreb index",
      "formula_verbatim": "$M2Φm(G)=∑_{uv∈E(G)}[(1)/(c(u)c(v))]=∑_{1≤t,s≤χ(G)}^{t<s}[(1)/(tsη_{ts})]$",
      "family": "chromatic (proper vertex colouring)",
      "source": "Equations (1)-(4)"
    },
    {
      "symbol_verbatim": "HM1Φ(G)",
      "name_verbatim": "Chromatic first hyper Zagreb index",
      "formula_verbatim": "$HM_{1}^{Φ}(G)=∑_{uv∈E(G)}[c(u)+c(v)]^{2}=∑_{1≤t,s≤χ(G)}^{t<s}η_{ts}[t+s]^{2}$",
      "family": "chromatic (proper vertex colouring)",
      "source": "Equations (1)-(4)"
    },
    {
      "symbol_verbatim": "HM2Φ(G)",
      "name_verbatim": "Chromatic second hyper Zagreb index",
      "formula_verbatim": "$HM_{2}^{Φ}(G)=∑_{uv∈E(G)}[c(u)c(v)]^{2}=∑_{1≤t,s≤χ(G)}^{t<s}η_{ts}[ts]^{2}$",
      "family": "chromatic (proper vertex colouring)",
      "source": "Equations (1)-(4)"
    }
  ],
